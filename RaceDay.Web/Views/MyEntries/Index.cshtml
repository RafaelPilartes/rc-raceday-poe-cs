@model List<MyEntry>
@{
    ViewData["Title"] = "My entries";
}

<h1 class="h3 page-heading">My entries</h1>

@if (Model.Count == 0)
{
    <div class="card p-4 text-center">
        <p class="mb-3 text-muted">You have not entered a race yet.</p>
        <div><a asp-controller="Events" asp-action="Index" class="btn btn-primary">Find a race</a></div>
    </div>
}
else
{
    <div class="card">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Race</th>
                    <th>Category</th>
                    <th>Entered on</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@entry.EventId" class="fw-semibold">
                                @entry.EventName
                            </a>
                            <div class="text-muted small">@entry.EventDate.ToString("d MMM yyyy HH:mm")</div>
                        </td>
                        <td>@entry.CategoryName</td>
                        <td>@entry.EnrolmentDate.ToString("d MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="@entry.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
