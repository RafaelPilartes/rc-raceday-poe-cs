@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<h1 class="h3 page-heading">Edit @Model.CategoryName</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="CategoryId" />
            <input type="hidden" asp-for="EventId" />

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="MinAge" class="form-label"></label>
                    <input asp-for="MinAge" class="form-control" />
                    <span asp-validation-for="MinAge" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="MaxAge" class="form-label"></label>
                    <input asp-for="MaxAge" class="form-control" />
                    <span asp-validation-for="MaxAge" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" step="0.01" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save category</button>
            <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
