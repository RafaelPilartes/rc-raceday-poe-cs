@model List<EventEntry>
@{
    var raceEvent = (EventDetail)ViewData["Event"]!;
    ViewData["Title"] = "Entries";
}

<h1 class="h3 page-heading">Entries for @raceEvent.EventName</h1>
<p class="text-muted">@raceEvent.EventDate.ToString("d MMM yyyy") · @raceEvent.Location · @Model.Count entered</p>

@if (Model.Count == 0)
{
    <div class="card p-4 text-center text-muted">
        Nobody has entered this event yet.
    </div>
}
else
{
    <div class="card">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Entered on</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.OrderBy(item => item.CategoryName).ThenBy(item => item.ParticipantName))
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@entry.ParticipantName</span>
                            <div class="text-muted small">@entry.ParticipantEmail</div>
                        </td>
                        <td>@entry.CategoryName</td>
                        <td>@entry.EnrolmentDate.ToString("d MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="@entry.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-controller="MyEvents" asp-action="Edit" asp-route-id="@raceEvent.EventId" class="btn btn-link">Back to the event</a>
</div>
