@model List<EventEntry>
@{
    var raceEvent = (EventDetail)ViewData["Event"]!;
    ViewData["Title"] = "Entries";
}

<div class="page-header">
    <div>
        <h1>Entries for @raceEvent.EventName</h1>
        <p class="lead-note numeric">@raceEvent.EventDate.ToString("d MMM yyyy") · @raceEvent.Location · @Model.Count entered</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <p>Nobody has entered this race yet.</p>
        <div class="race-meta">Entries appear here as soon as participants sign up.</div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Entered on</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.OrderBy(item => item.CategoryName).ThenBy(item => item.ParticipantName))
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@entry.ParticipantName</span>
                                <div class="cell-note">@entry.ParticipantEmail</div>
                            </td>
                            <td>@entry.CategoryName</td>
                            <td class="numeric">@entry.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="@entry.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-controller="MyEvents" asp-action="Edit" asp-route-id="@raceEvent.EventId" class="btn btn-link">Back to the event</a>
</div>
