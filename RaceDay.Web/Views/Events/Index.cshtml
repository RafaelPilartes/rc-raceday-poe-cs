@model EventSearchViewModel
@{
    ViewData["Title"] = "Events";
}

<h1 class="h3 page-heading">Find a race</h1>

<form asp-action="Index" method="get" class="card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" placeholder="Cape Town" />
        </div>
        <div class="col-md-3">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="">Any type</option>
                @foreach (var eventType in EventTypes.All)
                {
                    <option value="@eventType">@eventType</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </div>
    <div class="form-check mt-3">
        <input asp-for="UpcomingOnly" class="form-check-input" />
        <label asp-for="UpcomingOnly" class="form-check-label"></label>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="card p-4 text-center text-muted">
        No races match that search. Try widening it.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var raceEvent in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(raceEvent.BannerImageUrl))
                    {
                        <img src="@raceEvent.BannerImageUrl" alt="@raceEvent.EventName" class="card-event-banner" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@raceEvent.EventName</h2>
                        <p class="text-muted mb-2">
                            @raceEvent.EventDate.ToString("d MMM yyyy HH:mm")<br />
                            @raceEvent.Location
                        </p>
                        <p class="mb-3"><span class="badge text-bg-light">@raceEvent.EventType</span> @raceEvent.DistanceKm km</p>
                        <a asp-action="Details" asp-route-id="@raceEvent.EventId"
                           class="btn btn-outline-primary mt-auto">View race</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
