@model List<EventEntry>
@{
    var raceEvent = (EventDetail)ViewData["Event"]!;
    ViewData["Title"] = "Results";
    var raceHasBeenRun = raceEvent.EventDate <= DateTime.Now;
    var published = Model.Count(entry => entry.FinishTime is not null);
}

<h1 class="h3 page-heading">Results for @raceEvent.EventName</h1>
<p class="text-muted">
    @raceEvent.EventDate.ToString("d MMM yyyy") · @published of @Model.Count entries have a result
</p>

@if (!raceHasBeenRun)
{
    <div class="alert alert-warning">
        This race has not been run yet. Results can be captured from
        @raceEvent.EventDate.ToString("d MMM yyyy") onwards.
    </div>
}

@if (Model.Count == 0)
{
    <div class="card p-4 text-center text-muted">Nobody entered this event.</div>
}
else
{
    <div class="card">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th style="width: 160px;">Finish time</th>
                    <th style="width: 110px;">Position</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <form asp-action="Save" method="post">
                            <input type="hidden" name="EventId" value="@raceEvent.EventId" />
                            <input type="hidden" name="EnrolmentId" value="@entry.EnrolmentId" />
                            <input type="hidden" name="AlreadyCaptured" value="@(entry.FinishTime is not null)" />

                            <td>
                                <span class="fw-semibold">@entry.ParticipantName</span>
                                <div class="text-muted small">@entry.ParticipantEmail</div>
                            </td>
                            <td>@entry.CategoryName</td>
                            <td>
                                <input type="text" name="FinishTime" value="@entry.FinishTime"
                                       class="form-control form-control-sm" placeholder="00:52:18"
                                       disabled="@(!raceHasBeenRun)" />
                            </td>
                            <td>
                                <input type="number" name="FinishingPosition" value="@entry.FinishingPosition"
                                       class="form-control form-control-sm" min="1"
                                       disabled="@(!raceHasBeenRun)" />
                            </td>
                            <td>
                                <button type="submit" class="btn btn-sm btn-primary" disabled="@(!raceHasBeenRun)">
                                    @(entry.FinishTime is null ? "Publish" : "Correct")
                                </button>
                            </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-controller="MyEvents" asp-action="Edit" asp-route-id="@raceEvent.EventId" class="btn btn-link">Back to the event</a>
</div>
