@model List<OrganiserEvent>
@{
    ViewData["Title"] = "Dashboard";
    var upcomingEvents = Model.Where(raceEvent => raceEvent.EventDate >= DateTime.Now)
        .OrderBy(raceEvent => raceEvent.EventDate)
        .ToList();
    var totalEnrolments = Model.Sum(raceEvent => raceEvent.EnrolmentCount);
}

<h1 class="h3 page-heading">Organiser dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-tile">
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Events created</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-tile">
            <div class="stat-value">@totalEnrolments</div>
            <div class="stat-label">Total enrolments</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-tile">
            <div class="stat-value">@(upcomingEvents.Count > 0 ? upcomingEvents[0].EventDate.ToString("d MMM") : "—")</div>
            <div class="stat-label">Next race day</div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card p-4 text-center">
        <p class="mb-3">You have not published any events yet.</p>
        <div><a asp-controller="MyEvents" asp-action="Create" class="btn btn-primary">Create your first event</a></div>
    </div>
}
else
{
    <h2 class="h5 mb-3">Your events</h2>
    <div class="card">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th class="text-end">Enrolments</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var raceEvent in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="MyEvents" asp-action="Edit" asp-route-id="@raceEvent.EventId">
                                @raceEvent.EventName
                            </a>
                            <div class="text-muted small">@raceEvent.EventType · @raceEvent.DistanceKm km</div>
                        </td>
                        <td>@raceEvent.EventDate.ToString("d MMM yyyy")</td>
                        <td>@raceEvent.Location</td>
                        <td class="text-end fw-bold">@raceEvent.EnrolmentCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
