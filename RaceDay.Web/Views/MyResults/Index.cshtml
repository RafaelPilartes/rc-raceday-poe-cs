@model List<MyResult>
@{
    ViewData["Title"] = "My results";
}

<div class="page-header">
    <div><h1>My results</h1></div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <p>No results yet.</p>
        <div class="race-meta">They appear here once the organiser publishes them after a race.</div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Race</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Placing</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@result.EventName</td>
                            <td class="numeric">@result.EventDate.ToString("d MMM yyyy")</td>
                            <td>@result.CategoryName</td>
                            <td class="numeric fw-semibold">@(result.FinishTime ?? "—")</td>
                            <td class="numeric">@result.Placing</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
