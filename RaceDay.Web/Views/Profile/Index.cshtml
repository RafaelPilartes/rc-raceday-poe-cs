@model ProfileFormViewModel
@{
    ViewData["Title"] = "My profile";
}

<h1 class="h3 page-heading">My profile</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ProfilePictureUrl" />

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Email address</label>
                <input class="form-control" value="@Model.Email" disabled />
                <div class="form-text">Your email is how you sign in, so it cannot be changed here.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Role</label>
                <input class="form-control" value="@Model.Role" disabled />
            </div>

            <div class="mb-4">
                <label asp-for="PictureFile" class="form-label"></label>
                <input asp-for="PictureFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">JPEG, PNG or WebP, up to 5 MB.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save profile</button>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="card p-3 text-center">
            <h2 class="h6">Profile picture</h2>
            @if (string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <p class="text-muted mb-0">No picture yet.</p>
            }
            else
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile picture"
                     class="img-fluid rounded" style="max-height: 220px; object-fit: cover;" />
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
