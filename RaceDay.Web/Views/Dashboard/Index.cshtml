@model List<OrganiserEvent>
@{
    ViewData["Title"] = "Dashboard";
    var upcomingEvents = Model.Where(raceEvent => raceEvent.EventDate >= DateTime.Now)
        .OrderBy(raceEvent => raceEvent.EventDate)
        .ToList();
    var totalEnrolments = Model.Sum(raceEvent => raceEvent.EnrolmentCount);
}

<div class="page-header">
    <div><h1>Organiser dashboard</h1></div>
    <a asp-controller="MyEvents" asp-action="Create" class="btn btn-primary">Publish an event</a>
</div>

<div class="metric-strip">
    <div class="metric">
        <div class="metric-value">@Model.Count</div>
        <span class="label">Events created</span>
    </div>
    <div class="metric">
        <div class="metric-value">@totalEnrolments</div>
        <span class="label">Total enrolments</span>
    </div>
    <div class="metric">
        <div class="metric-value">@(upcomingEvents.Count > 0 ? upcomingEvents[0].EventDate.ToString("d MMM") : "—")</div>
        <span class="label">Next race day</span>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <p>You have not published any events yet.</p>
        <div><a asp-controller="MyEvents" asp-action="Create" class="btn btn-primary">Create your first event</a></div>
    </div>
}
else
{
    <h2 class="mb-3">Your events</h2>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th class="text-end">Enrolments</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>
                                <a class="quiet-link fw-semibold" asp-controller="MyEvents" asp-action="Edit" asp-route-id="@raceEvent.EventId">
                                    @raceEvent.EventName
                                </a>
                                <div class="cell-note numeric">@raceEvent.EventType · @raceEvent.DistanceKm km</div>
                            </td>
                            <td class="numeric">@raceEvent.EventDate.ToString("d MMM yyyy")</td>
                            <td>@raceEvent.Location</td>
                            <td class="text-end numeric fw-semibold">@raceEvent.EnrolmentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
