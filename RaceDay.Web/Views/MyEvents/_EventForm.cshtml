@model EventFormViewModel

<div asp-validation-summary="All" class="text-danger mb-3"></div>
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="BannerImageUrl" />

<div class="mb-3">
    <label asp-for="EventName" class="form-label"></label>
    <input asp-for="EventName" class="form-control" />
    <span asp-validation-for="EventName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" step="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            @foreach (var eventType in EventTypes.All)
            {
                <option value="@eventType">@eventType</option>
            }
        </select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="BannerFile" class="form-label"></label>
    <input asp-for="BannerFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
    <div class="form-text">JPEG, PNG or WebP, up to 5 MB.</div>

    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" alt="Current banner" class="img-fluid rounded mt-2" style="max-height: 150px;" />
    }
</div>
