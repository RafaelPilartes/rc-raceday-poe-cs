@model List<MyEntry>
@{
    ViewData["Title"] = "My entries";
}

<div class="page-header">
    <div><h1>My entries</h1></div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <p>You have not entered a race yet.</p>
        <div><a asp-controller="Events" asp-action="Index" class="btn btn-primary">Find a race</a></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Race</th>
                        <th>Category</th>
                        <th>Entered on</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@entry.EventId" class="quiet-link fw-semibold">
                                    @entry.EventName
                                </a>
                                <div class="cell-note numeric">@entry.EventDate.ToString("d MMM yyyy HH:mm")</div>
                            </td>
                            <td>@entry.CategoryName</td>
                            <td class="numeric">@entry.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="@entry.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
