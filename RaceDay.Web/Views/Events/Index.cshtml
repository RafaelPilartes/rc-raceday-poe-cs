@model EventSearchViewModel
@{
    ViewData["Title"] = "Events";
}

<div class="page-header">
    <div><h1>Find a race</h1></div>
</div>

<form asp-action="Index" method="get" class="card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" placeholder="Cape Town" />
        </div>
        <div class="col-md-3">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="">Any type</option>
                @foreach (var eventType in EventTypes.All)
                {
                    <option value="@eventType">@eventType</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </div>
    <div class="form-check mt-3">
        <input asp-for="UpcomingOnly" class="form-check-input" />
        <label asp-for="UpcomingOnly" class="form-check-label"></label>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="card empty-state">
        <p>No races match that search.</p>
        <div><a asp-action="Index" class="btn btn-outline-primary">Clear the filters</a></div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var raceEvent in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card race-card">
                    @if (!string.IsNullOrEmpty(raceEvent.BannerImageUrl))
                    {
                        <img src="@raceEvent.BannerImageUrl" alt="" class="race-card__banner" />
                    }
                    else
                    {
                        <div class="race-card__banner race-card__banner--empty">RaceDay</div>
                    }

                    <div class="card-body">
                        <div class="race-card__date">@raceEvent.EventDate.ToString("ddd d MMM yyyy")</div>
                        <h2 class="h5 mt-1 mb-2">
                            <a class="quiet-link stretched-link" asp-action="Details" asp-route-id="@raceEvent.EventId">
                                @raceEvent.EventName
                            </a>
                        </h2>
                        <p class="race-meta mb-3">@raceEvent.Location</p>
                        <div class="d-flex align-items-center gap-2">
                            <span class="type-tag">@raceEvent.EventType</span>
                            <span class="race-meta numeric">@raceEvent.DistanceKm km</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
