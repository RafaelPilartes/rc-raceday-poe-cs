@model List<OrganiserEvent>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 page-heading mb-0">My events</h1>
    <a asp-action="Create" class="btn btn-primary">Publish an event</a>
</div>

@if (Model.Count == 0)
{
    <div class="card p-4 text-center text-muted">
        You have not published any events yet.
    </div>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th class="text-end">Enrolments</th>
                    <th class="text-end">Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var raceEvent in Model)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@raceEvent.EventName</span>
                            <div class="text-muted small">@raceEvent.EventType · @raceEvent.DistanceKm km</div>
                        </td>
                        <td>@raceEvent.EventDate.ToString("d MMM yyyy HH:mm")</td>
                        <td>@raceEvent.Location</td>
                        <td class="text-end fw-bold">@raceEvent.EnrolmentCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@raceEvent.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@raceEvent.EventId" class="btn btn-sm btn-outline-secondary">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
