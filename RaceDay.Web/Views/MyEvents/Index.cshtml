@model List<OrganiserEvent>
@{
    ViewData["Title"] = "My events";
}

<div class="page-header">
    <div><h1>My events</h1></div>
    <a asp-action="Create" class="btn btn-primary">Publish an event</a>
</div>

@if (Model.Count == 0)
{
    <div class="card empty-state">
        <p>You have not published any events yet.</p>
        <div><a asp-action="Create" class="btn btn-primary">Publish your first event</a></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th class="text-end">Enrolments</th>
                        <th class="text-end">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@raceEvent.EventName</span>
                                <div class="cell-note numeric">@raceEvent.EventType · @raceEvent.DistanceKm km</div>
                            </td>
                            <td class="numeric">@raceEvent.EventDate.ToString("d MMM yyyy HH:mm")</td>
                            <td>@raceEvent.Location</td>
                            <td class="text-end numeric fw-semibold">@raceEvent.EnrolmentCount</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@raceEvent.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@raceEvent.EventId" class="btn btn-sm btn-outline-secondary">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
